# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais envoyé sur GitHub ; ce fichier-ci ne contient aucune valeur.

# Base de données Supabase : bouton « Connect » → « Session pooler » (port 5432).
# En production serverless, le « Transaction pooler » (port 6543) convient pour l'application : le code
# désactive alors tout seul les requêtes préparées (sinon les requêtes se bloquent). Mais les migrations
# (npm run db:migrate) doivent toujours utiliser le Session pooler (5432).
DATABASE_URL=

# Better Auth : clé secrète (32 octets aléatoires en base64) et adresse de l'application
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connexion avec Google : identifiant OAuth créé dans Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stockage des logos : Supabase Storage via son API compatible S3 (Storage > S3 Connection).
# Le bucket est public en lecture ; seul le serveur y écrit, avec ces clés.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_LOGOS=campaign-logos
# Facultative avec Supabase (déduite du point d'accès) ; OBLIGATOIRE avec tout autre fournisseur (R2, MinIO, AWS) :
# l'application refuse de démarrer le stockage sans elle (adresse publique des fichiers, sans « / » final).
# S3_PUBLIC_BASE_URL=
