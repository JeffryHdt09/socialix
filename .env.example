# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais envoyé sur GitHub ; ce fichier-ci ne contient aucune valeur.

# Base de données Supabase : bouton « Connect » → « Session pooler » (port 5432).
# En production serverless, le « Transaction pooler » (port 6543) convient pour l'application : le code
# désactive alors tout seul les requêtes préparées (sinon les requêtes se bloquent). Mais les migrations
# (npm run db:migrate) doivent toujours utiliser le Session pooler (5432).
DATABASE_URL=

# Better Auth : clé secrète (32 octets aléatoires en base64) et adresse de l'application
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connexion avec Google : identifiant OAuth créé dans Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stockage des logos : Supabase Storage via son API compatible S3 (Storage > S3 Connection).
# Le bucket est public en lecture ; seul le serveur y écrit, avec ces clés.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_LOGOS=campaign-logos
# Facultative avec Supabase, hébergé ou local (point d'accès en /storage/v1/s3, adresse déduite) ; OBLIGATOIRE avec
# tout autre fournisseur (R2, MinIO, AWS) :
# l'application refuse de démarrer le stockage sans elle (adresse publique des fichiers, sans « / » final).
# S3_PUBLIC_BASE_URL=

# Modèles d'IA (chapitres 9 à 11). Les agents essaient les modèles dans l'ordre : Gemini d'abord, puis OpenRouter quand
# Gemini répond « quota atteint » ou tombe en panne (src/lib/models.ts).
# Gemini : clé gratuite sur https://aistudio.google.com (limites petites : quelques dizaines de requêtes par jour).
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenRouter : https://openrouter.ai, clé dans « Keys ». Sans clé, OpenRouter est simplement ignoré.
# Les modèles gratuits (nom terminé par « :free ») sont limités à 20 requêtes par minute, et à 50 par jour tant qu'on n'a pas
# acheté au moins 10 $ de crédits (1 000 par jour ensuite, limite permanente).
OPENROUTER_API_KEY=
# Facultatif : les modèles à utiliser, séparés par des virgules, dans l'ordre. Des modèles payants plus puissants se placent
# AVANT les gratuits (ex. « anthropic/claude-sonnet-4.5,google/gemma-4-31b-it:free »). Vide = modèles gratuits par défaut.
# OPENROUTER_MODELS=

# Inngest (chapitre 11, tâches de fond). En local, rien à renseigner : lancer « npm run inngest » dans un second terminal
# (serveur de dev sur http://localhost:8288) en plus de « npm run dev ». En production (chapitre 18) :
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
