# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais envoyé sur GitHub ; ce fichier-ci ne contient aucune valeur.

# Base de données Supabase : bouton « Connect » → « Session pooler » (port 5432)
DATABASE_URL=

# Better Auth : clé secrète (32 octets aléatoires en base64) et adresse de l'application
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connexion avec Google : identifiant OAuth créé dans Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
